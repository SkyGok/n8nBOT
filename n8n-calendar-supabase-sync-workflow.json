      "id": "supabase-get-appointments",
      "name": "Get Supabase Appointments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get calendar events from input\nconst calendarEvents = $input.all();\n\n// Get Supabase appointments from previous node\nconst supabaseAppointments = $('Get Supabase Appointments').all();\n\n// Create a map of Supabase appointments by calendar_event_id\nconst supabaseMap = new Map();\nsupabaseAppointments.forEach(item => {\n  const appt = item.json;\n  if (appt.calendar_event_id) {\n    supabaseMap.set(appt.calendar_event_id, appt);\n  }\n});\n\n// Process calendar events\nconst results = [];\n\ncalendarEvents.forEach(item => {\n  const event = item.json;\n  const eventId = event.id || event.iCalUID || event.etag;\n  \n  // Extract event data\n  const eventData = {\n    calendar_event_id: eventId,\n    title: event.summary || event.title || 'Untitled Event',\n    start_time: event.start?.dateTime || event.start?.date || null,\n    end_time: event.end?.dateTime || event.end?.date || null,\n    description: event.description || null,\n    status: event.status === 'cancelled' ? 'cancelled' : 'active'\n  };\n  \n  const existingAppt = supabaseMap.get(eventId);\n  \n  if (!existingAppt) {\n    // New event - needs to be inserted\n    results.push({\n      json: {\n        action: 'insert',\n        data: eventData\n      }\n    });\n  } else {\n    // Check if update is needed\n    const needsUpdate = \n      existingAppt.title !== eventData.title ||\n      existingAppt.start_time !== eventData.start_time ||\n      existingAppt.end_time !== eventData.end_time ||\n      (existingAppt.description || '') !== (eventData.description || '') ||\n      existingAppt.status !== eventData.status;\n    \n    if (needsUpdate) {\n      results.push({\n        json: {\n          action: 'update',\n          id: existingAppt.id,\n          data: eventData\n        }\n      });\n    }\n    \n    // Mark as processed\n    supabaseMap.delete(eventId);\n  }\n});\n\n// Remaining Supabase appointments that don't exist in calendar should be cancelled\nsupabaseMap.forEach((appt, eventId) => {\n  if (appt.status !== 'cancelled') {\n    results.push({\n      json: {\n        action: 'cancel',\n        id: appt.id\n      }\n    });\n  }\n});\n\nreturn results;"
      },
      "id": "compare-and-prepare",
      "name": "Compare & Prepare Actions",
