            },
            "Content-Type: application/json",
            "Prefer: return=representation"
          ]
        },
        "options": {
          "queryParameters": {
            "parameters": [
              {
                "name": "status",
                "value": "eq.active"
              },
              {
                "name": "select",
                "value": "id,title,start_time,end_time,description,status,calendar_event_id"
